ENV=development

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
SUPABASE_JWT_SECRET=YOUR-SUPABASE-JWT-SECRET

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

FACE_MATCH_THRESHOLD=0.70
FACE_DISTANCE_TOLERANCE=0.6
QR_EXPIRY_SECONDS=120

RATE_LIMIT_DEFAULT=60/minute

# Private codes required to self-register as Teacher/Admin — pick your own
# values, share only with real staff. Do not commit real values to git.
TEACHER_SIGNUP_CODE=change-this-teacher-code
ADMIN_SIGNUP_CODE=change-this-admin-code
